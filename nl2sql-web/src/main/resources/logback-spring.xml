<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds">
    
    <!-- 属性定义 - 使用绝对路径 -->
    <property name="LOG_HOME" value="D:/WorkSpace/idea workspace/NL2Sql/logs" />
    <property name="APP_NAME" value="NL2SQL" />
    <property name="MAX_HISTORY" value="30" />
    <property name="MAX_FILE_SIZE" value="100MB" />
    
    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{requestId}] [%thread] [%-5level] %logger{36}:%line - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- 主日志文件（所有级别） -->
    <appender name="FILE_ALL" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}.log</file>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{requestId}] [%thread] [%-5level] %logger{36}:%line - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- 错误日志文件（仅ERROR级别） -->
    <appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{requestId}] [%thread] [%-5level] %logger{36}:%line - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/${APP_NAME}-error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- SQL日志文件（仅SQL相关） -->
    <appender name="FILE_SQL" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/sql.log</file>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{requestId}] [%thread] [%-5level] %logger{36}:%line - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/sql.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Agent日志文件（智能体相关） -->
    <appender name="FILE_AGENT" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/agent.log</file>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{requestId}] [%thread] [%-5level] %logger{36}:%line - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/agent.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- LLM日志文件（大模型调用） -->
    <appender name="FILE_LLM" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/llm.log</file>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{requestId}] [%thread] [%-5level] %logger{36}:%line - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/llm.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
            <maxHistory>${MAX_HISTORY}</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
    </appender>
    
    <!-- Spring JDBC日志（输出到SQL文件） -->
    <logger name="org.springframework.jdbc.core" level="INFO" additivity="false">
        <appender-ref ref="FILE_SQL" />
        <appender-ref ref="FILE_ALL" />
    </logger>
    
    <!-- Agent相关日志（输出到Agent文件） -->
    <logger name="com.nl2sql.core.agent" level="INFO" additivity="false">
        <appender-ref ref="FILE_AGENT" />
        <appender-ref ref="FILE_ALL" />
    </logger>
    
    <!-- Skills加载器详细日志 -->
    <logger name="com.nl2sql.core.agent.skills.SkillsMetadataLoader" level="DEBUG" additivity="false">
        <appender-ref ref="FILE_AGENT" />
        <appender-ref ref="FILE_ALL" />
    </logger>
    
    <!-- LLM Provider日志（输出到LLM文件） -->
    <logger name="com.nl2sql.core.llm.provider" level="DEBUG" additivity="false">
        <appender-ref ref="FILE_LLM" />
        <appender-ref ref="FILE_ALL" />
    </logger>
    
    <!-- 业务日志 -->
    <logger name="com.nl2sql" level="INFO" additivity="false">
        <appender-ref ref="FILE_ALL" />
        <appender-ref ref="FILE_ERROR" />
    </logger>
    
    <!-- 第三方库日志级别控制 -->
    <logger name="org.springframework" level="WARN" />
    <logger name="org.apache.catalina" level="WARN" />
    <logger name="com.zaxxer.hikari" level="WARN" />
    <logger name="org.hibernate" level="WARN" />
    
    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE_ALL" />
        <appender-ref ref="FILE_ERROR" />
    </root>
</configuration>
