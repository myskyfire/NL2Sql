<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nl2sql.metadata.mapper.SqlTemplateMapper">
    
    <!-- 根据模板 ID 查询模板内容 -->
    <select id="selectTemplateContentByTemplateId" resultType="java.lang.String">
        SELECT template_content 
        FROM sql_template 
        WHERE template_id = #{templateId} 
          AND is_active = 1
    </select>
    
</mapper>
