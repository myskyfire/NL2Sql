<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nl2sql.web.controller.mapper.MonitorControllerMapper">
    
    <!-- selectQueryLogs -->
    <select id="selectQueryLogs" resultType="java.util.Map">
        SELECT * FROM query_logs WHERE user_id = #{userId} ORDER BY created_at DESC LIMIT #{limit}
    </select>

    <!-- selectSystemMetrics -->
    <select id="selectSystemMetrics" resultType="java.util.List">
        SELECT * FROM system_metrics ORDER BY recorded_at DESC LIMIT 100
    </select>

</mapper>
