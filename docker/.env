# ============================================
# DataMind AI - Docker 部署环境变量
# ============================================
# 使用方式: docker-compose --env-file .env up -d

# ============ MySQL ============
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=nl2sql_meta_db
MYSQL_PORT=3306

# ============ Redis ============
REDIS_PORT=6379

# ============ ChromaDB (向量数据库) ============
CHROMA_PORT=8000

# ============ Ollama (本地 LLM + Embedding) ============
# 需要 GPU 才能流畅运行，CPU 模式也可用但较慢
OLLAMA_PORT=11434
OLLAMA_EMBEDDING_MODEL=bge-m3
# 可选: 拉取 NLP 模型 (qwen3:8b, qwen2.5-coder:7b等)
OLLAMA_EXTRA_MODELS=

# ============ TEI Reranker (重排序) ============
# 需要 NVIDIA GPU，如无 GPU 请设 ENABLE_RERANKER=false
ENABLE_RERANKER=false
RERANKER_PORT=8081
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ============ NL2SQL 应用 ============
APP_PORT=8080
APP_VERSION=1.0.0

# ============ LLM API (阿里云通义千问) ============
# 如果没有本地 Ollama，必须配置此项
ALIYUN_API_KEY=your_aliyun_api_key_here

# ============ LangSmith (可选) ============
# 如不需要链路追踪，留空即可
LANGSMITH_API_KEY=

# ============ JVM 参数 ============
JAVA_OPTS=-Xms512m -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200